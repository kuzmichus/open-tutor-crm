{# Обложка: оффер, CTA, строка доверия и плейсхолдер фото. Адрес
   /s/<tutor_id> знает только сервер, поэтому подставляется при рендере
   редактора. `.j2` не входит в select_autoescape — экранируем явно, как в
   default_page.html.j2. #}
<section class="hero" aria-label="О занятиях">
  <div class="hero__body">
    <h1 class="hero__title">Подготовлю к ЕГЭ по математике на 80+ за 6 месяцев</h1>
    <p class="hero__subtitle">Репетитор по предмету. Разбираю пробелы в базе, учу решать по шагам и веду до результата без зубрёжки.</p>
    <div class="hero__actions">
      <a class="btn" href="{{ cta_url | e }}">Записаться на бесплатное пробное</a>
      <a class="link-quiet" href="#pricing">Посмотреть цены</a>
    </div>
    <p class="hero__hint">Пробное занятие бесплатное и ни к чему не обязывает.</p>
    <p class="hero__trust">
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
        <strong>8 лет</strong> опыта
      </span>
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
        <strong>84</strong> — средний балл ЕГЭ
      </span>
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
        <strong>40+</strong> учеников подготовлено
      </span>
    </p>
  </div>
  <div class="hero__media">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="3" y="3" width="18" height="18" rx="3"/>
      <circle cx="9" cy="9" r="2"/>
      <path d="m21 15-3.5-3.5a2 2 0 0 0-2.8 0L6 20"/>
    </svg>
    <span>Фото репетитора</span>
  </div>
</section>
